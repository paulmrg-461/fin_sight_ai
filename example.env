# Public local-development placeholders. Never commit real credentials.
# Copy to .env and load it with: flutter run --dart-define-from-file=.env
# .env is local-only and must never be bundled as a Flutter asset.
# Production keys are injected with --dart-define=SUPABASE_URL=... etc.
SUPABASE_URL=
SUPABASE_ANON_KEY=
GROQ_API_KEY=
